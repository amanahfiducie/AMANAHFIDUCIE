# 1) Copier ce fichier :  cp .dev.vars.example .dev.vars
# 2) Éditer .dev.vars (PAS ce fichier .example) — Cloudflare / Vite ne charge que .dev.vars
# https://developers.cloudflare.com/workers/configuration/secrets/

RESEND_API_KEY=
RESEND_FROM_EMAIL=Amanah Fiducie <onboarding@resend.dev>
CONTACT_TO_EMAIL=amanahfiducie@gmail.com

# OTP — Gmail (équivalent Flask-Mail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=amanahfiducie@gmail.com
SMTP_PASS=
SMTP_FROM_EMAIL=Amanah Fiducie <amanahfiducie@gmail.com>
EMAIL_USE_TLS=1
# 0 = OTP uniquement vers l'e-mail du compte (SMTP). 1 = secours Resend.
OTP_USE_RESEND=0
# 1 = en dev seulement : si Resend mode test, relayer vers CONTACT_TO_EMAIL
# OTP_RESEND_FORWARD_TO_ADMIN=0

# Développement : accepter le formulaire sans envoyer d’e-mail (logs console uniquement).
# SKIP_CONTACT_EMAIL=1

# Brevo (optionnel) :
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_USER=votre-login@smtp-brevo.com
