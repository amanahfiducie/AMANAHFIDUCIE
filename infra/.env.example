# Copier ce fichier pour surcharger les variables du compose :
#   cp infra/.env.example infra/.env
# Puis utilisez :
#   docker compose --env-file infra/.env -f infra/docker-compose.yml up -d

POSTGRES_DB=sofigepam
POSTGRES_USER=sofigepam
POSTGRES_PASSWORD=sofigepam

# Décommentez uniquement si 5432 est déjà utilisé sur la machine :
# POSTGRES_PORT=5433

# Décommentez si besoin pour éviter d’autres collisions :
# REDIS_PORT=6380
# MINIO_API_PORT=9005
# MINIO_CONSOLE_PORT=9006
