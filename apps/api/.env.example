# Développement local — après : docker compose -f ../../infra/docker-compose.yml up -d
SECRET_KEY=change-me-in-dev
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost

# Si 1, utilise SQLite (aucun PostgreSQL requis)
USE_SQLITE=0

POSTGRES_DB=sofigepam
POSTGRES_USER=sofigepam
POSTGRES_PASSWORD=sofigepam
POSTGRES_HOST=127.0.0.1
# Si Docker publie Postgres sur un autre port (ex. 5433 quand 5432 est déjà pris localement),
# alignez cette valeur avec `POSTGRES_PORT` du `docker compose` (voir infra/.env.example).
POSTGRES_PORT=5432

# Origines CORS pour Next.js (dev)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Connexion OTP — en dev le code s'affiche à l'écran si l'e-mail échoue (ou toujours si display)
# LOGIN_OTP_METHOD=display|auto|email
LOGIN_OTP_METHOD=display

# Stockage documents — 0 = fichiers locaux (media/), 1 = MinIO/S3
USE_S3=0
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=sofigepam-documents
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_S3_USE_SSL=0
DOCUMENT_DOWNLOAD_URL_EXPIRY=3600
