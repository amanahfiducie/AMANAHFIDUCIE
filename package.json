{
  "name": "amanah-fiducie-monorepo",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/api-client",
    "packages/shared-types"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "cd apps/api && . .venv/bin/activate && python manage.py runserver 0.0.0.0:8000",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  }
}
